[Unit]
Description=Encrypted backups of isolated SocialCli candidate and private Auth
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/blades3/projects/socialcli-saas/ops/backup_host.py /home/blades3/projects/socialcli-saas/private/backup-candidate.json
Environment=RESTIC_CACHE_DIR=/home/blades3/projects/socialcli-saas/backups/candidate/cache
UMask=0077
TimeoutStartSec=600
KillMode=control-group
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/blades3/projects/socialcli-saas/backups /home/blades3/projects/socialcli-saas/private/recovery-repository-candidate
