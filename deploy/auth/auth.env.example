# Dedicated instance; never reuse another application's JWT or database credentials.
GOTRUE_API_HOST=0.0.0.0
PORT=9999
API_EXTERNAL_URL=https://socialcli.app/auth/v1
GOTRUE_SITE_URL=https://socialcli.app
GOTRUE_URI_ALLOW_LIST=https://socialcli.app/account/
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://socialcli_auth:REPLACE@db:5432/socialcli_auth
DB_NAMESPACE=auth
GOTRUE_DB_MAX_POOL_SIZE=10
GOTRUE_JWT_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_MAILER_OTP_EXP=600
GOTRUE_MAILER_OTP_LENGTH=6
GOTRUE_SMTP_HOST=mail.florentino.pro
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=REPLACE
GOTRUE_SMTP_PASS=REPLACE
GOTRUE_SMTP_ADMIN_EMAIL=access@socialcli.app
GOTRUE_SMTP_SENDER_NAME=SocialCli
GOTRUE_SMTP_MAX_FREQUENCY=60s
GOTRUE_RATE_LIMIT_EMAIL_SENT=100
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
LOG_LEVEL=error
GOTRUE_MAILER_TEMPLATES_CONFIRMATION=http://templates/otp.html
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=http://templates/otp.html
GOTRUE_MAILER_SUBJECTS_CONFIRMATION=Your SocialCli sign-in code
GOTRUE_MAILER_SUBJECTS_MAGIC_LINK=Your SocialCli sign-in code
